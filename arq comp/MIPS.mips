
# in c:
# int fib(int n){
# if (n <= 1) {
#   return n;
# }
# return fib(n-1) + fib(n-2);

fib:
  addi $sp, $sp, -8     # cria um espaco de 8 bits na memoria
  sw $ra, 8($sp)        # guarda o endereco da main na pilha
  sw $a0, 4($sp)        # guarda o endereco de n na pilha

  slti $t0, $a0, 2      # compara n com 2 (tipo bool) e seta $t0 com 1 ou 0
  beq  $t0, $zero, Else # se n >= 2, vai para Else
  add  $v0, $a0, $zero  # se n < 2, retorna n em v0

  jr $ra                # volta pra main (ou recursivamente para a funcao fib)

  Else:
  addi $a0, $a0, -1     # adiciona -1 a n (fib(n-1))

  jal fib               # chama a funcao fib(n-1) recursivamente
  add $t1, $v0, $zero   # guarda o resultado de fib(n-1) em $t1
  addi $a0, $a0, -1     # adiciona -1 a n (fib(n-2))

  jal fib               # chama a funcao fib(n-2) recursivamente
  add $v0, $t1, $v0     # soma os resultados de fib(n-1) e fib(n-2)
  lw $a0, 4($sp)        # recupera o valor de n da pilha
  lw $ra, 8($sp)        # recupera o endereco da main da pilha
  addi $sp, $sp, 8      # libera o espaco de 8 bits na memoria

  jr $ra                # volta pra main



# potencia em c:
#
# int potencia (int a, int n){
# if (n == 0){
#   return 1;
#   }
# return a * potencia(a, n-1);
# }

# a1 = n / a0 = a


pow:
  addi $sp, $sp, -8
  sw $ra, 0($sp)
  sw $a1, 4($sp) # a1 = n
  addi $t0, $zero, 1 # atribui 1 a $t0

  beq $a1, $zero, Base

Else:
  addi $a1, $a1, -1 # n = n-1
  jal pow # chama recursivamente com n => n-1

  mul $v0, $vo, $a0
  J Fim

Base: 
  addi $v0, $zero, 1

Fim:
  lw $a1, 4($sp)
  lw $ra, 0($sp)
  addi $sp, $sp, 8

  jr $ra




  # f = f + a[6];
  # b[8] = a[i] + a[j];
  # b[34] = a[3] + f - j;
  # while (b[i] == k)
  # i = i + j;
  #
  # f = $s0, i = $s1, j = $s2
  # end. base.: a[] = $s5, b[] = $s6, k = $s7


lw $t0, 24($s5) # a[6]

sll $a1, $s1, 2
add $t1, $a1, $s5
lw $t2, 0($t1) # a[i]

sll $t1, $s2, 2
add $t1, $t1, $s5 
lw $t3, 0($t1) # a[j]

lw $t4, 32($s6) # b[8]

lw $t5, 136($s6) # b[34]

lw $t6, 12($s5) # a[3]

add $s0, $s0, $t0

add $t4, $t2, $t3
sw $t4, 32($s6)

add $t5, $t6, $s0
sub $t5, $t5, $s2
sw $t5, 136($s6)

While:
  sll $a1, $s1, 2 
  add $t1, $a1, $s6
  lw $t7, 0($t1) # b[i]

  bne $t7, $s7, Fim_While
  add $s1, $s1, $s2

  J While

Fim_While:





# int is_sorted(int *v, int n) {  
# for (int i = 0; i < n-1; i++) {
#       if (v[i] > v[i+1]) return 0;
#     }
#   return 1;
#}
#
# v[] = $s1 | i = $s2 | n = $s3

addi $s2, $zero, 0
addi $s4, $s3, -1 # n-1 = $s4


For:
  bge $s2, $s4, Fim_for

  sll $a0, $s2, 2
  add $t1, $a0, $s1
  lw $t3, 0($t1)
  lw $t4, 4($t1)

  ble $t3, $t4, Else
  addi $v0, $zero, 0
  J Fim
  
Else:
  addi $s2, $s2, 1
  J For

Fim_for:
  addi $v0, $zero, 1
  J Fim

Fim:





